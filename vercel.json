{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p public && cp web/*.html public/",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 15, "includeFiles": "server/**" }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
