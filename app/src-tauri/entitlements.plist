<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WKWebView (Tauri's renderer) needs JIT under the hardened runtime. This is
       the minimal set — no disable-library-validation, no unsigned-executable-memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Outbound network for the backend API calls made from Rust (reqwest). -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
